    ".ckpt",
    ".bin",
    ".safetensors",
    ".npy",
    ".npz",
    ".pkl",
    ".pickle",
    ".parquet",
    ".feather",
    ".png",
    ".jpg",
    ".jpeg",
    ".tif",
    ".tiff",
    ".bmp",
    ".webp",
    ".gif",
    ".mp4",
    ".wav",
    ".pyc"
  ],
  "allowed_absolute_path_prefixes": [
    "c:/windows/",
    "c:/program files/",
    "c:/program files (x86)/"
  ],
  "allowed_email_patterns": [
    "^[0-9]+\\+[A-Za-z0-9-]+@users\\.noreply\\.github\\.com$",
    "^[A-Za-z0-9-]+@users\\.noreply\\.github\\.com$"
  ],
  "notes": [
    "The root .git metadata is skipped; nested Git repositories and every symlink or reparse point are rejected.",
    "Small data-shaped files are permitted only in examples/synthetic* or tests/fixtures*; configuration JSON is permitted in configs/.",
    "Synthetic paths are a packaging boundary, not proof of synthetic provenance. Reviewers must confirm that examples were authored from scratch.",
    "The scanner reports relative file paths, rule names and line numbers, never the matched text.",
    "Root Git history is outside this working-tree scan. Start with a clean repository history and review git ls-files before publishing."
  ]
}
