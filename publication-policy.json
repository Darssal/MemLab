{
  "schema_version": 1,
  "purpose": "Publish reviewed MemLab source and offline tests without private research data or credentials.",
  "max_file_bytes": 262144,
  "max_synthetic_bytes": 65536,
  "approved_project_roots": [],
  "approved_root_files": [
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY.md",
    ".gitignore",
    ".gitattributes",
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "publication-policy.json",
    "CITATION.cff",
    "LICENSE",
    "NOTICE",
    ".env.example"
  ],
  "approved_top_level_directories": [
    "tools",
    "tests",
    "docs",
    ".github",
    "memlab",
    "benchmarks",
    "scripts",
    "configs",
    "sql",
    "infra"
  ],
  "approved_project_directories": [],
  "approved_project_root_names": [],
  "approved_source_extensions": [
    ".py",
    ".md",
    ".rst",
    ".toml",
    ".yaml",
    ".yml",
    ".ini",
    ".cfg",
    ".conf",
    ".ps1",
    ".sh",
    ".sql",
    ".c",
    ".h",
    ".cc",
    ".cpp",
    ".hpp",
    ".cmake",
    ".cff"
  ],
  "synthetic_data_extensions": [
    ".json",
    ".jsonl",
    ".csv",
    ".tsv",
    ".txt"
  ],
  "forbidden_directory_names": [
    "data",
    "dataset",
    "datasets",
    "raw",
    "private",
    "outputs",
    "output",
    "runs",
    "logs",
    "wandb",
    "checkpoints",
    "model",
    "models",
    "weights",
    "adapters",
    "artifacts",
    "results",
    "rlhf_data",
    "materials",
    "third_party",
    ".venv",
    "venv",
    "node_modules",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".cache",
    "cache"
  ],
  "forbidden_extensions": [
    ".pdf",
    ".doc",
    ".docx",
    ".xls",
    ".xlsx",
    ".ppt",
    ".pptx",
    ".zip",
    ".rar",
    ".7z",
    ".tar",
    ".gz",
    ".sqlite",
